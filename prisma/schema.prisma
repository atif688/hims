// HIMS OPD - Prisma schema (SQLite build)
// Native enums are emulated as strings (SQLite doesn't support enums).
// Valid values are documented inline. Application-level enums:
//
//   Role:                SUPER_ADMIN | HOSPITAL_ADMIN | DOCTOR | NURSE |
//                        RECEPTIONIST | LAB_STAFF | RADIOLOGY_STAFF |
//                        PHARMACIST | PATIENT
//   Gender:              MALE | FEMALE | OTHER
//   PatientCategory:     NEW | REPEAT | CORPORATE | GOVT_SCHEME |
//                        EMERGENCY | REFERRED
//   HistoryType:         DIAGNOSIS_CHRONIC | DIAGNOSIS_ACUTE |
//                        DIAGNOSIS_RESOLVED | SURGERY | PROCEDURE |
//                        HOSPITALIZATION | LIFESTYLE_* | FEMALE_*
//   AllergySeverity:     MILD | MODERATE | SEVERE | LIFE_THREATENING
//   AppointmentStatus:   SCHEDULED | CHECKED_IN | IN_CONSULTATION |
//                        COMPLETED | CANCELLED | NO_SHOW
//   AppointmentPriority: ROUTINE | URGENT | EMERGENCY
//   PlanStatus:          ACTIVE | COMPLETED | CANCELLED
//   PrescriptionStatus:  PRESCRIBED | READY | DISPENSED |
//                        PARTIALLY_DISPENSED | REJECTED
//   LabKind:             LABORATORY | RADIOLOGY
//   LabOrderStatus:      ORDERED | SAMPLE_COLLECTED | IN_PROGRESS |
//                        RESULT_READY | REPORTED | CANCELLED
//   InvoiceStatus:       DRAFT | ISSUED | PARTIAL | PAID | REFUNDED |
//                        CANCELLED
//   PaymentMethod:       CASH | CARD | BANK_TRANSFER | WALLET | INSURANCE
//   NotificationChannel: IN_APP | EMAIL | SMS | PUSH
//   NotificationKind:    APPOINTMENT | LAB_RESULT | PRESCRIPTION |
//                        PAYMENT | CRITICAL_ALERT | FOLLOW_UP | SYSTEM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          String
  phone         String?
  active        Boolean  @default(true)
  twoFactorOn   Boolean  @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctorProfile  Doctor?
  patientProfile Patient?
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentId   String?

  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  about     String?
  createdAt DateTime @default(now())

  doctors   Doctor[]
  users     User[]
  schedules Schedule[]
}

model Doctor {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      String
  qualification  String?
  registrationNo String?
  consultFee     Float   @default(0)
  about          String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])

  schedules      Schedule[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  examinations   Examination[]
  treatmentPlans TreatmentPlan[]
  labOrders      LabOrder[]
}

model Patient {
  id              String   @id @default(cuid())
  mrn             String   @unique
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  fullName        String
  gender          String
  dob             DateTime
  bloodGroup      String?
  maritalStatus   String?
  nationality     String?  @default("Pakistani")
  occupation      String?
  education       String?
  cnic            String?  @unique
  phone           String
  altPhone        String?
  email           String?
  address         String?
  city            String?
  emergencyName   String?
  emergencyPhone  String?
  emergencyRel    String?
  category        String   @default("NEW")
  photoUrl        String?
  qrCode          String?  @unique
  registeredAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  insurances     Insurance[]
  allergies      Allergy[]
  history        MedicalHistory[]
  appointments   Appointment[]
  examinations   Examination[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  treatmentPlans TreatmentPlan[]
  invoices       Invoice[]
  documents      PatientDocument[]
  vaccinations   Vaccination[]
  familyHistory  FamilyHistory[]

  @@index([fullName])
  @@index([phone])
}

model PatientDocument {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category   String
  name       String
  url        String
  uploadedAt DateTime @default(now())
}

model Insurance {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider     String
  policyNumber String
  validTill    DateTime?
  coverage     Float?    @default(0)
  preauthRef   String?
  notes        String?
  createdAt    DateTime  @default(now())
}

model MedicalHistory {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type       String
  title      String
  details    String?
  severity   String?
  occurredAt DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([patientId, type])
}

model FamilyHistory {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relation  String
  condition String
  notes     String?
  createdAt DateTime @default(now())
}

model Allergy {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String
  substance String
  reaction  String?
  severity  String   @default("MILD")
  notedAt   DateTime @default(now())

  @@index([patientId])
}

model Vaccination {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccine    String
  doseNumber Int      @default(1)
  givenAt    DateTime
  nextDueAt  DateTime?
  notes      String?
}

model Schedule {
  id           String    @id @default(cuid())
  doctorId     String
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  weekday      Int
  startTime    String
  endTime      String
  slotMinutes  Int       @default(15)
  isBlocked    Boolean   @default(false)
  blockReason  String?
  validFrom    DateTime?
  validTo      DateTime?
  createdAt    DateTime  @default(now())

  @@index([doctorId, weekday])
}

model Appointment {
  id          String    @id @default(cuid())
  visitNo     String    @unique
  tokenNo     Int
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor    @relation(fields: [doctorId], references: [id])
  scheduledAt DateTime
  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  status      String    @default("SCHEDULED")
  priority    String    @default("ROUTINE")
  reason      String?
  source      String    @default("WALK_IN")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  examination  Examination?
  prescription Prescription?
  labOrders    LabOrder[]
  invoice      Invoice?

  @@index([scheduledAt])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model Examination {
  id                 String   @id @default(cuid())
  appointmentId      String   @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             Doctor   @relation(fields: [doctorId], references: [id])
  bpSystolic         Int?
  bpDiastolic        Int?
  pulse              Int?
  tempC              Float?
  respRate           Int?
  spo2               Int?
  heightCm           Float?
  weightKg           Float?
  bmi                Float?
  chiefComplaint     String?
  hopi               String?
  systemicExam       String?
  generalExam        String?
  diagnosis          String?
  icdCodes           String?
  painScore          Int?
  gcsScore           Int?
  clinicalImpression String?
  signedAt           DateTime?
  signedBy           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TreatmentPlan {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  title          String
  problemList    String?
  shortTermGoals String?
  longTermGoals  String?
  dietPlan       String?
  exercisePlan   String?
  counseling     String?
  referral       String?
  status         String   @default("ACTIVE")
  startedAt      DateTime @default(now())
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Medication {
  id           String   @id @default(cuid())
  name         String   @unique
  genericName  String?
  form         String?
  strength     String?
  manufacturer String?
  stockQty     Int      @default(0)
  reorderLevel Int      @default(20)
  unitPrice    Float    @default(0)
  expiryDate   DateTime?
  barcode      String?  @unique
  createdAt    DateTime @default(now())

  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id             String      @id @default(cuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor      @relation(fields: [doctorId], references: [id])
  status         String      @default("PRESCRIBED")
  advice         String?
  followUpDate   DateTime?
  printedAt      DateTime?
  dispensedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String?
  medication     Medication?  @relation(fields: [medicationId], references: [id])
  drugName       String
  dose           String
  frequency      String
  route          String?
  durationDays   Int?
  instructions   String?
  quantity       Int          @default(1)
  dispensedQty   Int          @default(0)
}

model LabTest {
  id               String  @id @default(cuid())
  code             String  @unique
  name             String
  kind             String  @default("LABORATORY")
  category         String?
  price            Float   @default(0)
  prepInstructions String?
  refRange         String?
  units            String?
  active           Boolean @default(true)
  createdAt        DateTime @default(now())

  orderItems LabOrderItem[]
}

model LabOrder {
  id             String       @id @default(cuid())
  orderNo        String       @unique
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  status         String       @default("ORDERED")
  priority       String       @default("ROUTINE")
  clinicalNotes  String?
  collectedAt    DateTime?
  resultedAt     DateTime?
  reportedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items LabOrderItem[]
}

model LabOrderItem {
  id          String   @id @default(cuid())
  labOrderId  String
  labOrder    LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  testId      String
  test        LabTest  @relation(fields: [testId], references: [id])
  resultValue String?
  resultUnits String?
  refRange    String?
  flag        String?
  remarks     String?
  reportedAt  DateTime?
}

model Invoice {
  id            String       @id @default(cuid())
  invoiceNo     String       @unique
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  status        String       @default("DRAFT")
  subtotal      Float        @default(0)
  discount      Float        @default(0)
  tax           Float        @default(0)
  total         Float        @default(0)
  amountPaid    Float        @default(0)
  notes         String?
  issuedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        String
  refId       String?
  description String
  qty         Int     @default(1)
  unitPrice   Float   @default(0)
  discount    Float   @default(0)
  total       Float   @default(0)
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Float
  method     String
  reference  String?
  receivedBy String?
  receivedAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String    @default("IN_APP")
  kind      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
}
